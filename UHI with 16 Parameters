// ==============================================================================
// CORE HARMONIZATION FUNCTION (Handles Landsat 5 and Landsat 8)
// ==============================================================================
function getLandsat(year) {
  var collection;
  var bands;
  
  // Use Landsat 5 for 2000, 2005, 2010. Use Landsat 8 for 2015, 2020, 2025.
  if (year < 2013) {
    collection = "LANDSAT/LT05/C02/T1_L2";
    bands = ['SR_B1', 'SR_B2', 'SR_B3', 'SR_B4', 'SR_B5', 'SR_B7', 'ST_B6']; // L5 Bands
  } else {
    collection = "LANDSAT/LC08/C02/T1_L2";
    bands = ['SR_B2', 'SR_B3', 'SR_B4', 'SR_B5', 'SR_B6', 'SR_B7', 'ST_B10']; // L8 Bands
  }

  // Load the dataset for the requested year
  var img = ee.ImageCollection(collection)
    .filterBounds(pmrda)
    .filterDate(year + '-01-01', year + '-12-31')
    .filter(ee.Filter.lt('CLOUD_COVER', 15))
    .median()
    .select(bands, ['Blue', 'Green', 'Red', 'NIR', 'SWIR1', 'SWIR2', 'Thermal']) // Rename to standard names
    .clip(pmrda);

  // Apply C02 scaling factors
  var opt = img.select(['Blue', 'Green', 'Red', 'NIR', 'SWIR1', 'SWIR2']).multiply(0.0000275).add(-0.2);
  var therm = img.select('Thermal').multiply(0.00341802).add(149.0).subtract(273.15).rename('BT'); // 13. Brightness Temp

  // OPTICAL INDICES
  var ndvi = opt.normalizedDifference(['NIR', 'Red']).rename('NDVI'); // 2. NDVI
  var ndbi = opt.normalizedDifference(['SWIR1', 'NIR']).rename('NDBI'); // 3. NDBI
  var ndwi = opt.normalizedDifference(['Green', 'NIR']).rename('NDWI'); // 15. NDWI
  var mndvi = opt.normalizedDifference(['Green', 'SWIR1']).rename('MNDVI'); // 4. MNDVI
  
  var savi = opt.expression('((NIR - R) / (NIR + R + 0.5)) * 1.5', { // 16. SAVI
    'NIR': opt.select('NIR'), 'R': opt.select('Red')
  }).rename('SAVI');

  var albedo = opt.expression( // 10. Surface Albedo
    '(0.356*Blue) + (0.130*Red) + (0.373*NIR) + (0.085*SWIR1) + (0.072*SWIR2) - 0.0018', {
      'Blue': opt.select('Blue'), 'Red': opt.select('Red'), 'NIR': opt.select('NIR'),
      'SWIR1': opt.select('SWIR1'), 'SWIR2': opt.select('SWIR2')
    }).rename('Albedo');

  // THERMAL INDICES (LST & Emissivity)
  var fvc = ndvi.subtract(0.2).divide(0.3).clamp(0, 1).pow(2); 
  var emiss = fvc.multiply(0.004).add(0.986).rename('Emissivity'); // 12. Emissivity

  var lst = therm.expression( // 1. LST
    'BT / (1 + (0.00115 * BT / 1.4388) * log(E))', {
      'BT': therm, 'E': emiss
    }).rename('LST');

  // 14. Urban TFVI
  var lstStats = lst.reduceRegion({
    reducer: ee.Reducer.mean().combine(ee.Reducer.stdDev(), null, true),
    geometry: pmrda, scale: 300, maxPixels: 1e10
  });
  var tfvi = lst.subtract(ee.Number(lstStats.get('LST_mean')))
                .divide(ee.Number(lstStats.get('LST_stdDev'))).rename('TFVI');

  return opt.addBands([ndvi, ndbi, ndwi, mndvi, savi, albedo, therm, emiss, lst, tfvi]);
}

// Generate harmonized image data for all 5-year intervals
