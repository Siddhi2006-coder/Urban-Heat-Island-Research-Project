// IMPORTANT:
// Clear_night_cov is calculated from the ORIGINAL MODIS
// collection rather than the LST quality-masked collection.
//
// ================================================================

function yearlyNightClearCoverage(year) {

  year = ee.Number(year);

  var start =
    ee.Date.fromYMD(
      year,
      3,
      1
    );

  var end =
    ee.Date.fromYMD(
      year,
      6,
      1
    );

  var collection =
    modis.filterDate(
      start,
      end
    );

  var clearSky =
    collection
      .select(
        'Clear_night_cov'
      )
      .mean()
      .multiply(0.0005)
      .rename(
        'Night_Clear_Sky_Coverage'
      )
      .clip(puneGeometry)
      .set('year', year);

  return clearSky;
}


