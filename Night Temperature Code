function yearlyNightAirTemperature(year) {

  year = ee.Number(year);

  var start =
    ee.Date.fromYMD(
      year,
      3,
      1
    );

  var end =
    ee.Date.fromYMD(
      year,
      6,
      1
    );

  var collection =
    era5
      .filterDate(
        start,
        end
      )
      .filter(
        ee.Filter.inList(
          'hour',
          nightHoursUTC
        )
      );

  var temperature =
    collection
      .mean()
      .subtract(273.15)
      .rename(
        'Night_Air_Temperature_C'
      )
      .clip(puneGeometry)
      .set('year', year);

  return temperature;
}


// ================================================================
// 10. YEARLY NIGHT LST
// ================================================================

function yearlyNightLST(year) {

  year = ee.Number(year);

  var start =
    ee.Date.fromYMD(
      year,
      3,
      1
    );

  var end =
    ee.Date.fromYMD(
      year,
      6,
      1
    );

  var collection =
    modisNight
      .filterDate(
        start,
        end
      );

  var lst =
    collection
      .select(
        'LST_Night_1km'
      )
      .mean()
      .multiply(0.02)
      .subtract(273.15)
      .rename(
        'Night_LST_C'
      )
      .clip(puneGeometry)
      .set('year', year);

  return lst;
}


// ================================================================
// 11. YEARLY NIGHT EMISSIVITY
// ================================================================

function yearlyNightEmissivity(year) {

  year = ee.Number(year);

  var start =
    ee.Date.fromYMD(
      year,
      3,
      1
    );

  var end =
    ee.Date.fromYMD(
      year,
      6,
      1
    );

  var collection =
    modisNight
      .filterDate(
        start,
        end
      );

  var emissivity31 =
    collection
      .select('Emis_31')
      .mean()
      .multiply(0.002)
      .rename(
        'Night_Emissivity_Band31'
      );

  var emissivity32 =
    collection
      .select('Emis_32')
      .mean()
      .multiply(0.002)
      .rename(
        'Night_Emissivity_Band32'
      );

  return emissivity31
    .addBands(emissivity32)
    .clip(puneGeometry)
    .set('year', year);
}


// ================================================================
