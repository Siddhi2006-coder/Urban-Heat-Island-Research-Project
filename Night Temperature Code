// ================================================================
// 7. MODIS NIGHTTIME QUALITY MASK
// ================================================================
//
// MOD11A1 QC_Night:
//
// Bits 0–1 = Mandatory QA
//
// 00 = LST produced, good quality
// 01 = LST produced, other quality
// 10 = LST not produced due to cloud
// 11 = LST not produced for other reasons
//
// We retain values 0 and 1 because both indicate that
// an LST value has been produced.
//
// We additionally mask:
// - zero LST digital values
// - invalid/missing LST values
//
// ================================================================

function maskNightLST(image) {

  var qc = image.select('QC_Night');

  var mandatoryQA =
    qc.bitwiseAnd(3);

  var goodQA =
    mandatoryQA.lte(1);

  var lstRaw =
    image.select('LST_Night_1km');

  var validLST =
    lstRaw.gt(0);

  return image
    .updateMask(goodQA)
    .updateMask(validLST);
}


